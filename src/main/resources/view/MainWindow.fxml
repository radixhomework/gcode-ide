<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            prefWidth="1000" prefHeight="700">
  <top>
    <MenuBar>
      <Menu text="File">
        <MenuItem text="New" onAction="#onNew" accelerator="Shortcut+N"/>
        <MenuItem text="Open..." onAction="#onOpen" accelerator="Shortcut+O"/>
        <SeparatorMenuItem/>
        <MenuItem text="Save" onAction="#onSave" accelerator="Shortcut+S"/>
        <MenuItem text="Save As..." onAction="#onSaveAs" accelerator="Shortcut+Shift+S"/>
        <MenuItem text="Save Preview Image..." onAction="#onSavePreviewImage"/>
      </Menu>
    </MenuBar>
  </top>
  <center>
    <SplitPane fx:id="splitPane"/>
  </center>
  <bottom>
    <HBox style="-fx-padding: 4 8 4 8; -fx-spacing: 12">
      <Label fx:id="posLabel" text="1:1"/>
      <Label fx:id="statsLabel" text=""/>
      <Region HBox.hgrow="ALWAYS"/>
      <Label fx:id="warningsLabel" text="" style="-fx-text-fill: #C00000; -fx-font-weight: bold"/>
      <Label text="Machine:"/>
      <ComboBox fx:id="profileCombo"/>
    </HBox>
  </bottom>
</BorderPane>
