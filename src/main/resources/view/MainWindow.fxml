<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            prefWidth="1000" prefHeight="700">
  <top>
    <MenuBar>
      <Menu text="File">
        <MenuItem text="New" onAction="#onNew" accelerator="Shortcut+N"/>
        <MenuItem text="Open..." onAction="#onOpen" accelerator="Shortcut+O"/>
        <MenuItem text="Import Image..." onAction="#onImportImage"/>
        <SeparatorMenuItem/>
        <MenuItem text="Save" onAction="#onSave" accelerator="Shortcut+S"/>
        <MenuItem text="Save As..." onAction="#onSaveAs" accelerator="Shortcut+Shift+S"/>
        <MenuItem text="Save Preview Image..." onAction="#onSavePreviewImage"/>
        <SeparatorMenuItem/>
        <MenuItem text="Settings..." onAction="#onOpenSettings" accelerator="Shortcut+Comma"/>
      </Menu>
      <Menu text="Edit">
        <MenuItem text="Go to Line..." onAction="#onGoToLine" accelerator="Shortcut+G"/>
      </Menu>
    </MenuBar>
  </top>
  <center>
    <SplitPane fx:id="splitPane"/>
  </center>
  <bottom>
    <HBox styleClass="status-bar">
      <Label fx:id="posLabel" text="1:1" styleClass="status-text"/>
      <Label fx:id="statsLabel" text="" styleClass="status-text"/>
      <Region HBox.hgrow="ALWAYS"/>
      <Label fx:id="warningsLabel" text="" styleClass="warning-chip"/>
    </HBox>
  </bottom>
</BorderPane>
